# Local development is the default. Set DJANGO_ENV=production in the hosting
# service's process environment; production deliberately does not load .env.
DJANGO_ENV=development

EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=False
TRANSACTIONAL_EMAILS_ENABLED=True
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_MAX_BODY_BYTES=131072
RESEND_TIMEOUT_SECONDS=30

DEFAULT_FROM_EMAIL="DertDerman <info@dertderman.com>"
EMAIL_REPLY_TO=destek@dertderman.com

SUPPORT_EMAIL=destek@dertderman.com
SUPPORT_PHONE="+90 850 532 2206"
SUPPORT_HOURS="Hafta içi 09:00 - 18:00"

SITE_BASE_URL=http://127.0.0.1:8000

# Production-only placeholders (set these in the hosting environment):
# DJANGO_SECRET_KEY=replace-with-a-generated-secret
# DJANGO_ALLOWED_HOSTS=dertderman.com,www.dertderman.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dertderman.com,https://www.dertderman.com
# SITE_BASE_URL=https://dertderman.com
#
# Production filesystem storage.
# Both paths must be absolute and must not overlap.
# Static files are rebuildable via collectstatic.
# Media files are persistent user/application uploads.
# DJANGO_STATIC_ROOT=/var/lib/dertderman/static
# DJANGO_MEDIA_ROOT=/var/lib/dertderman/media
#
# Production database -- PostgreSQL is mandatory.
# POSTGRES_DB=dertderman
# POSTGRES_USER=dertderman
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60
# POSTGRES_CONNECT_TIMEOUT=5
#
# Production shared cache / rate limiting -- Redis is mandatory.
# REDIS_URL=redis://127.0.0.1:6379/0
#
# Production session cookie lifetime in seconds.
# DJANGO_SESSION_COOKIE_AGE=28800
#
# Server-side authentication session security.
# USER:    8h idle / 8h absolute
# COMPANY: 2h idle / 8h absolute
# ADMIN:   30m idle / 4h absolute
# DJANGO_AUTH_SESSION_SECURITY_ENABLED=True
# DJANGO_SESSION_ACTIVITY_TOUCH_SECONDS=60
# DJANGO_AUTH_SESSION_REAUTH_MAX_AGE_SECONDS=300
# DJANGO_USER_SESSION_IDLE_SECONDS=28800
# DJANGO_USER_SESSION_ABSOLUTE_SECONDS=28800
# DJANGO_COMPANY_SESSION_IDLE_SECONDS=7200
# DJANGO_COMPANY_SESSION_ABSOLUTE_SECONDS=28800
# DJANGO_ADMIN_SESSION_IDLE_SECONDS=1800
# DJANGO_ADMIN_SESSION_ABSOLUTE_SECONDS=14400
#
# Maximum simultaneously active authenticated sessions.
# DJANGO_USER_MAX_ACTIVE_SESSIONS=5
# DJANGO_COMPANY_MAX_ACTIVE_SESSIONS=3
# DJANGO_ADMIN_MAX_ACTIVE_SESSIONS=2
#
# Keep HSTS disabled until HTTPS and trusted-proxy behavior
# are verified on the real deployment. Then stage 3600 before
# considering a long-lived value such as 31536000.
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# Enable only when a trusted reverse proxy sanitizes and sets this header:
# DJANGO_TRUST_X_FORWARDED_PROTO=False

EMAIL_VERIFICATION_TIMEOUT=1800
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_CHANGE_TIMEOUT=600

# Security / rate limiting
RATE_LIMIT_ENABLED=True
TRUST_CLOUDFLARE_CONNECTING_IP=False
PASSWORD_RESET_TIMEOUT=300
