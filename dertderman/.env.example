# Local development is the default. Set DJANGO_ENV=production in the hosting
# service's process environment; production deliberately does not load .env.
DJANGO_ENV=development

EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=False
TRANSACTIONAL_EMAILS_ENABLED=True
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_MAX_BODY_BYTES=131072
RESEND_TIMEOUT_SECONDS=30

DEFAULT_FROM_EMAIL="DertDerman <info@dertderman.com>"
EMAIL_REPLY_TO=destek@dertderman.com

SUPPORT_EMAIL=destek@dertderman.com
SUPPORT_PHONE="+90 850 532 2206"
SUPPORT_HOURS="Hafta içi 09:00 - 18:00"

SITE_BASE_URL=http://127.0.0.1:8000

# Production-only placeholders (set these in the hosting environment):
# DJANGO_SECRET_KEY=replace-with-a-generated-secret
# DJANGO_ALLOWED_HOSTS=dertderman.com,www.dertderman.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dertderman.com,https://www.dertderman.com
# SITE_BASE_URL=https://dertderman.com
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
# Enable only when a trusted reverse proxy sanitizes and sets this header:
# DJANGO_TRUST_X_FORWARDED_PROTO=False

EMAIL_VERIFICATION_TIMEOUT=1800
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_CHANGE_TIMEOUT=600

# Security / rate limiting
RATE_LIMIT_ENABLED=True
TRUST_CLOUDFLARE_CONNECTING_IP=False
PASSWORD_RESET_TIMEOUT=300
